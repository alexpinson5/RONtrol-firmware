#!/bin/bash -e

# Download the latest firmware release from GitHub, check it against its
# published SHA-256 sum and install it.  Each release carries two assets:
#
#   bbctrl-<version>.tar.bz2         the package built by 'make pkg'
#   bbctrl-<version>.tar.bz2.sha256  its 'sha256sum' line, from 'make release'
#
# src/js/app.js checks the same repository for the latest version.

REPO=alexpinson5/RONtrol-firmware
API=https://api.github.com/repos/$REPO/releases/latest
DOWNLOAD=https://github.com/$REPO/releases/download

# Give up on a connection that can't be made, or that stalls below 1 kB/s
# for a minute, rather than hang the upgrade and hold its lock forever
CURL="curl -fsSL --connect-timeout 30 --speed-limit 1024 --speed-time 60"

(
    flock -n 9 || { echo "An upgrade is already running"; exit 1; }

    if ! JSON=$($CURL "$API"); then
      echo "Could not reach GitHub to find the latest release."
      echo "Check the controller's network connection and clock ($(date))."
      exit 1
    fi

    TAG=$(echo "$JSON" |
      python3 -c 'import json, sys; print(json.load(sys.stdin)["tag_name"])')
    VERSION=${TAG#v}
    PKG_NAME=bbctrl-$VERSION.tar.bz2
    PKG=/var/lib/bbctrl/firmware/update.tar.bz2

    logger Installing bbctrl firmware $VERSION

    cd /var/lib/bbctrl
    mkdir -p firmware

    echo Downloading $DOWNLOAD/$TAG/$PKG_NAME
    if ! $CURL "$DOWNLOAD/$TAG/$PKG_NAME" -o $PKG; then
      rm -f $PKG
      echo "Download of $PKG_NAME failed"
      exit 1
    fi

    if ! SUM=$($CURL "$DOWNLOAD/$TAG/$PKG_NAME.sha256"); then
      rm -f $PKG
      echo "Download of $PKG_NAME.sha256 failed"
      exit 1
    fi
    SUM=${SUM%% *} # sha256sum line: '<sum>  <file>'

    if ! echo "$SUM  $PKG" | sha256sum --check --status; then
      rm -f $PKG
      logger bbctrl firmware $VERSION failed its SHA-256 check, not installed
      echo "SHA-256 check failed, not installing"
      exit 1
    fi

    /usr/local/bin/update-bbctrl

    echo Success

    logger bbctrl firmware $VERSION installed

) 9> /var/lock/bbctrl.upgrade.lock
